{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JVault",
  "version": "0.1.0",
  "identifier": "com.jvault.dev",
  "build": {
    "frontendDist": "src/Templates",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "JVault",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
    "csp": null,
    "assetProtocol": {
      "enable": true,
      "scope": ["$APPDATA/**", "$HOME/**"]
    } 
 }
  },
  "bundle": {
    "active": true,
    "targets":["deb", "rpm"],
      "category": "Utility",
     "shortDescription": "Game launcher with torrent-based install and Proton support",
        "longDescription": "JVault is a Linux game launcher that manages your library, downloads games via magnet links, installs them automatically, and runs them using a Proton compatibility Layer. It provides a unified interface for managing and launching games locally.",
"icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
